# Optional. The CLI does not load environment files automatically.
# node --env-file=.env src/cli.js watch
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SOLANA_WS_URL=wss://solana-rpc.publicnode.com
SOLANA_RPC_INTERVAL_MS=1200
SOLANA_POLL_MS=60000
SOLANA_BATCH_SIZE=20
MONERO_WALLET_RPC_URL=http://127.0.0.1:28088/json_rpc
MONERO_DAEMON_URL=http://127.0.0.1:18081
MONERO_WALLET_RPC_BIN=monero-wallet-rpc
MONERO_POLL_MS=30000
MONERO_CONFIRMATIONS=10
# Zero scans all Monero history. Increasing this explicitly limits coverage.
MONERO_RESTORE_HEIGHT=0
# Wallet account 0; unresolved published subaddresses are reported in status.
MONERO_SUBADDRESS_LOOKAHEAD=50000
WATCHER_DATA_DIR=./data
