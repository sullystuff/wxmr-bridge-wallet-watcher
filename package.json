{
  "name": "wxmr-public-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only wXMR deposit and withdrawal watcher using published Monero view keys and finalized Solana records",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node src/cli.js watch",
    "once": "node src/cli.js once",
    "wallet": "node src/cli.js wallet",
    "status": "node src/cli.js status",
    "events": "node src/cli.js events",
    "verify:public": "node scripts/verify-public.js",
    "check:public": "node scripts/check-public.js",
    "test": "node --test"
  },
  "dependencies": {
    "bs58": "6.0.0",
    "json-bigint": "1.0.0",
    "ws": "8.18.3"
  }
}
